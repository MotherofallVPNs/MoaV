# Minimal WireGuard container - uses config directly without auto-generation
FROM alpine:3.24

RUN apk add --no-cache \
    wireguard-tools \
    iptables \
    ip6tables \
    iproute2

# Create config directory
RUN mkdir -p /etc/wireguard

COPY scripts/wireguard-entrypoint.sh /entrypoint.sh
COPY scripts/lib/egress-isolation.sh /egress-isolation.sh
# Explicit modes: the checkout may be owner-only (umask 077) and COPY keeps that.
RUN chmod 755 /entrypoint.sh && chmod 644 /egress-isolation.sh

ENTRYPOINT ["/entrypoint.sh"]

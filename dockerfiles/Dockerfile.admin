# Admin stats dashboard
FROM python:3.12-alpine

RUN apk add --no-cache \
    tzdata \
    bash \
    docker-cli \
    docker-cli-compose \
    jq \
    curl \
    openssl \
    libqrencode-tools \
    su-exec

# Fixed uid/gid: host-side scripts chown bundles/state to 2000:2000 so the
# non-root app keeps rw without world-writable modes (see grant_admin_rw).
RUN addgroup -S -g 2000 moav && adduser -S -u 2000 -G moav moav

WORKDIR /app

COPY admin/requirements.txt /app/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY admin/ /app/
COPY scripts/admin-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && chown -R moav:moav /app

EXPOSE 8443

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/entrypoint.sh"]

# =============================================================================
# MoaV Client - Multi-protocol client for testing and connecting
# =============================================================================
# Supports: Reality, Trojan, AnyTLS, Hysteria2, XHTTP, WireGuard (via wstunnel),
#           AmneziaWG, dnstt, Slipstream (deprecated), TrustTunnel, Tor/Snowflake
#
# Strategy: Download pre-built binaries with proper architecture detection
# =============================================================================

# =============================================================================
# Builder stage - compile dnstt
# =============================================================================
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS dnstt-builder

# For cross-compilation
ARG TARGETARCH
ARG TARGETOS=linux
ARG DNSTT_VERSION=v1.20260501.0

# Go module fetch resilience (pipe = fall through on ANY error incl. 403).
# See Dockerfile.xray for the full rationale. Override via .env.
ARG GOPROXY="https://proxy.golang.org|https://goproxy.cn|direct"
ARG GOSUMDB=off
ENV GOPROXY=${GOPROXY} GOSUMDB=${GOSUMDB}

RUN apk add --no-cache git

# Build dnstt-client with cross-compilation, pinned to release tag
# Note: bamsoftware.com serves dumb HTTP (no `--depth 1 --branch <tag>`); full clone + checkout instead
RUN git clone https://www.bamsoftware.com/git/dnstt.git /tmp/dnstt && \
    git -C /tmp/dnstt checkout ${DNSTT_VERSION}

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd /tmp/dnstt/dnstt-client && \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} CGO_ENABLED=0 go build -o /dnstt-client . || touch /dnstt-client

# =============================================================================
# Builder stage - download slipstream-client (Rust, glibc-linked)
# Must run on Debian since the binary requires full glibc (__res_init, _Unwind_*)
# =============================================================================
FROM debian:bookworm-slim AS slipstream-builder

ARG TARGETARCH
ARG SLIPSTREAM_VERSION=2026.04.22.1

RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# SHA256-verified: pinned digests for the default version, else the release's SHA256SUMS.
RUN set -eu; \
    ARCH="${TARGETARCH:-amd64}"; \
    case "${ARCH}" in amd64|arm64) ;; *) echo "Unsupported TARGETARCH=${ARCH}" >&2; exit 1 ;; esac; \
    ASSET="slipstream-client-linux-${ARCH}"; \
    BASE="https://github.com/net2share/slipstream-rust-build/releases/download/v${SLIPSTREAM_VERSION}"; \
    wget -qO /usr/local/bin/slipstream-client "${BASE}/${ASSET}"; \
    case "${SLIPSTREAM_VERSION}/${ASSET}" in \
      2026.04.22.1/slipstream-client-linux-amd64) EXPECTED=45b83b84aed77edbce749fbf7a8ebf13df8a521424e51c51c1358084b46635f4 ;; \
      2026.04.22.1/slipstream-client-linux-arm64) EXPECTED=a042b907afa54df1e106407ef3f0922b7316e61ec6980b310b52b5631fad8e9b ;; \
      *) wget -qO /tmp/SHA256SUMS "${BASE}/SHA256SUMS"; \
         EXPECTED="$(awk -v a="${ASSET}" '$2 == a || $2 == "*" a {print $1; exit}' /tmp/SHA256SUMS)"; \
         rm -f /tmp/SHA256SUMS ;; \
    esac; \
    if [ -z "${EXPECTED}" ]; then echo "No SHA256 for ${ASSET} v${SLIPSTREAM_VERSION}" >&2; exit 1; fi; \
    ACTUAL="$(sha256sum /usr/local/bin/slipstream-client | cut -d' ' -f1)"; \
    if [ "${EXPECTED}" != "${ACTUAL}" ]; then \
      echo "SHA256 mismatch for ${ASSET}: expected ${EXPECTED}, got ${ACTUAL}" >&2; exit 1; \
    fi; \
    echo "slipstream-client SHA256 OK (${ACTUAL})"; \
    chmod +x /usr/local/bin/slipstream-client

# Bundle the glibc shared libs the binary needs so it runs on Alpine
RUN mkdir -p /slipstream-libs && \
    ldd /usr/local/bin/slipstream-client | grep -oP '/\S+' | \
    while read lib; do cp "$lib" /slipstream-libs/; done && \
    cp /lib64/ld-linux-x86-64.so.2 /slipstream-libs/ 2>/dev/null || \
    cp /lib/ld-linux-aarch64.so.1 /slipstream-libs/ 2>/dev/null || true

# Create a wrapper script that uses the bundled linker
RUN ARCH="${TARGETARCH:-amd64}" && \
    if [ "$ARCH" = "arm64" ]; then \
        LINKER="/slipstream-libs/ld-linux-aarch64.so.1"; \
    else \
        LINKER="/slipstream-libs/ld-linux-x86-64.so.2"; \
    fi && \
    echo '#!/bin/sh' > /slipstream-wrapper.sh && \
    echo "exec $LINKER --library-path /slipstream-libs /usr/local/bin/slipstream-client-bin \"\$@\"" >> /slipstream-wrapper.sh && \
    chmod +x /slipstream-wrapper.sh

# =============================================================================
# Final image - download pre-built binaries for correct architecture
# =============================================================================
FROM alpine:3.24

# Architecture detection for multi-arch support
ARG TARGETARCH

# Versions - read from .env via docker-compose build args, with fallback defaults
ARG SINGBOX_VERSION=1.14.4
ARG XRAY_VERSION=26.11.9
ARG WSTUNNEL_VERSION=11.1.0
ARG TRUSTTUNNEL_VERSION=1.3.1

# Install runtime dependencies
RUN apk add --no-cache \
    bash \
    curl \
    wget \
    jq \
    ca-certificates \
    iptables \
    ip6tables \
    iproute2 \
    bind-tools \
    tor \
    wireguard-tools \
    && rm -rf /var/cache/apk/*

# Architecture mapping helper script
# TARGETARCH from buildx: amd64, arm64, arm/v7, etc.
# Fallback to runtime detection if not set
RUN echo '#!/bin/sh' > /tmp/get-arch.sh && \
    echo 'if [ -n "$TARGETARCH" ]; then' >> /tmp/get-arch.sh && \
    echo '  echo "$TARGETARCH"' >> /tmp/get-arch.sh && \
    echo 'else' >> /tmp/get-arch.sh && \
    echo '  case "$(uname -m)" in' >> /tmp/get-arch.sh && \
    echo '    x86_64|amd64) echo "amd64" ;;' >> /tmp/get-arch.sh && \
    echo '    aarch64|arm64) echo "arm64" ;;' >> /tmp/get-arch.sh && \
    echo '    armv7l) echo "arm" ;;' >> /tmp/get-arch.sh && \
    echo '    *) echo "amd64" ;;' >> /tmp/get-arch.sh && \
    echo '  esac' >> /tmp/get-arch.sh && \
    echo 'fi' >> /tmp/get-arch.sh && \
    chmod +x /tmp/get-arch.sh

# Determine architecture once
RUN ARCH=$(/tmp/get-arch.sh) && echo "Building for architecture: $ARCH" && echo "$ARCH" > /tmp/arch

# sing-box: download pre-built binary. The -musl asset runs natively on Alpine;
# the plain linux-<arch> asset is glibc-dynamic and would need a glibc shim.
RUN ARCH=$(cat /tmp/arch) && \
    echo "Downloading sing-box for ${ARCH}..." && \
    wget -qO- "https://github.com/SagerNet/sing-box/releases/download/v${SINGBOX_VERSION}/sing-box-${SINGBOX_VERSION}-linux-${ARCH}-musl.tar.gz" | \
    tar xz -C /tmp && \
    mv /tmp/sing-box-${SINGBOX_VERSION}-linux-${ARCH}-musl/sing-box /usr/local/bin/ && \
    chmod +x /usr/local/bin/sing-box && \
    rm -rf /tmp/sing-box-* && \
    echo "sing-box ${SINGBOX_VERSION} installed (${ARCH})"

# xray-core: download pre-built binary (needed for XHTTP protocol)
# Xray uses: linux-64, linux-arm64-v8a
RUN ARCH=$(cat /tmp/arch) && \
    case "$ARCH" in \
        amd64) XRAY_ARCH="64" ;; \
        arm64) XRAY_ARCH="arm64-v8a" ;; \
        *) XRAY_ARCH="64" ;; \
    esac && \
    echo "Downloading Xray-core for ${XRAY_ARCH}..." && \
    wget -qO /tmp/xray.zip \
    "https://github.com/XTLS/Xray-core/releases/download/v${XRAY_VERSION}/Xray-linux-${XRAY_ARCH}.zip" && \
    unzip -j /tmp/xray.zip xray -d /usr/local/bin/ && \
    chmod +x /usr/local/bin/xray && \
    rm -f /tmp/xray.zip && \
    echo "xray-core ${XRAY_VERSION} installed (${XRAY_ARCH})" || \
    echo "xray-core: download failed (optional, needed for XHTTP)"

# wstunnel: download pre-built binary
# wstunnel uses underscore in filename: linux_amd64, linux_arm64
RUN ARCH=$(cat /tmp/arch) && \
    echo "Downloading wstunnel for ${ARCH}..." && \
    wget -qO- "https://github.com/erebe/wstunnel/releases/download/v${WSTUNNEL_VERSION}/wstunnel_${WSTUNNEL_VERSION}_linux_${ARCH}.tar.gz" | \
    tar xz -C /usr/local/bin/ wstunnel && \
    chmod +x /usr/local/bin/wstunnel && \
    echo "wstunnel ${WSTUNNEL_VERSION} installed (${ARCH})" || \
    echo "wstunnel: download failed (optional, needed for WireGuard-wstunnel)"

# snowflake-client is intentionally NOT bundled here. This image's job is to
# validate a user's server-side bundle + net perms (moav test) and connect
# (moav client); Snowflake is a Tor pluggable transport that belongs to the
# standalone MotherofallVPNs/moav-client, not the server's built-in tester.
# Dropping it also removes a heavy Go build stage from every `moav test`.

# dnstt-client: copy cross-compiled binary from builder
COPY --from=dnstt-builder /dnstt-client /usr/local/bin/dnstt-client
RUN chmod +x /usr/local/bin/dnstt-client 2>/dev/null && \
    echo "dnstt-client installed" || \
    echo "dnstt-client: not available (optional)"

# slipstream-client: copy from Debian builder (Rust binary needs full glibc)
# Binary + bundled glibc libs + wrapper script that invokes via the bundled ld-linux
COPY --from=slipstream-builder /usr/local/bin/slipstream-client /usr/local/bin/slipstream-client-bin
COPY --from=slipstream-builder /slipstream-libs/ /slipstream-libs/
COPY --from=slipstream-builder /slipstream-wrapper.sh /usr/local/bin/slipstream-client
RUN chmod +x /usr/local/bin/slipstream-client /usr/local/bin/slipstream-client-bin && \
    echo "slipstream-client installed (bundled glibc)"

# trusttunnel-client: download CLI client from TrustTunnelClient repo
# TrustTunnelClient uses: linux-x86_64, linux-aarch64
ARG TRUSTTUNNEL_CLIENT_VERSION=1.3.0
RUN ARCH=$(cat /tmp/arch) && \
    case "$ARCH" in \
        amd64) TT_ARCH="x86_64" ;; \
        arm64) TT_ARCH="aarch64" ;; \
        *) TT_ARCH="x86_64" ;; \
    esac && \
    echo "Downloading trusttunnel_client v${TRUSTTUNNEL_CLIENT_VERSION} for ${TT_ARCH}..." && \
    wget -qO /tmp/tt.tar.gz \
    "https://github.com/TrustTunnel/TrustTunnelClient/releases/download/v${TRUSTTUNNEL_CLIENT_VERSION}/trusttunnel_client-v${TRUSTTUNNEL_CLIENT_VERSION}-linux-${TT_ARCH}.tar.gz" && \
    tar xzf /tmp/tt.tar.gz -C /tmp --strip-components=1 && \
    mv /tmp/trusttunnel_client /usr/local/bin/ && \
    chmod +x /usr/local/bin/trusttunnel_client && \
    /usr/local/bin/trusttunnel_client --version && \
    rm -rf /tmp/tt.tar.gz /tmp/*.md /tmp/LICENSE /tmp/*.sig && \
    echo "trusttunnel_client v${TRUSTTUNNEL_CLIENT_VERSION} installed (${TT_ARCH})" || \
    echo "trusttunnel_client: download failed (optional)"

# amneziawg: download awg-tools for AmneziaWG client support
ARG AWGTOOLS_VERSION=3.1.20260812
RUN cd /tmp && \
    echo "Downloading awg-tools v${AWGTOOLS_VERSION}..." && \
    wget -qO awg-tools.zip "https://github.com/amnezia-vpn/amneziawg-tools/releases/download/v${AWGTOOLS_VERSION}/alpine-3.19-amneziawg-tools.zip" && \
    unzip -j awg-tools.zip -d /usr/local/bin/ && \
    rm -f awg-tools.zip && \
    chmod +x /usr/local/bin/awg /usr/local/bin/awg-quick && \
    echo "awg-tools v${AWGTOOLS_VERSION} installed" || \
    echo "awg-tools: download failed (optional, needed for AmneziaWG)"

# Cleanup
RUN rm -f /tmp/get-arch.sh /tmp/arch

# Create directories
RUN mkdir -p /config /app /state /var/log/moav

# Copy scripts
COPY scripts/client-entrypoint.sh /app/
COPY tests/client-test.sh /app/
COPY scripts/client-connect.sh /app/
RUN chmod +x /app/*.sh

# Default ports for proxy mode
# SOCKS5: 1080, HTTP: 8080
EXPOSE 1080 8080

# Health check (-4: see the curl note in tests/client-test.sh)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD curl -sf -4 --socks5 127.0.0.1:1080 https://www.google.com/generate_204 || exit 1

WORKDIR /app
ENTRYPOINT ["/app/client-entrypoint.sh"]
CMD ["--help"]

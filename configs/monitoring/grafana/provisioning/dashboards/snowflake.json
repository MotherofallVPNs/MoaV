      "pluginVersion": "10.4.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max_over_time(tor_snowflake_proxy_connections_total[$__range]))",
          "refId": "A"
        }
      ],
      "title": "People Served",
      "type": "stat",
      "description": "Connections completed in the selected time range. Counted with max_over_time, not increase: these tick once per completed connection and then sit flat, and increase() can only see growth from a previous sample, so every country's FIRST connection was invisible. Measured on a live proxy, increase saw 2 countries where max_over_time saw 7. Trade-off: if the container restarts mid-window this shows the larger run rather than the sum. snowflake counts a connection only when it ENDS, so a long-lived client relaying right now contributes nothing here until it disconnects \u2014 this can read 0 while Relay Throughput is busy."
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Countries Reached",
      "description": "Countries with at least one completed connection in the selected time range. '??' counts as one: the client IP was not in the geoip database. Counted with max_over_time, not increase: these tick once per completed connection and then sit flat, and increase() can only see growth from a previous sample, so every country's FIRST connection was invisible. Measured on a live proxy, increase saw 2 countries where max_over_time saw 7. Trade-off: if the container restarts mid-window this shows the larger run rather than the sum.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(sum by (country) (max_over_time(tor_snowflake_proxy_connections_total[$__range])) > 0)",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 15,
      "type": "gauge",
      "title": "Rendezvous Success Rate",
      "description": "Share of rendezvous attempts in the selected time range that produced a connection. A low number is normal: most attempts are clients that never come back, not failures on this proxy. Counted with max_over_time, not increase: these tick once per completed connection and then sit flat, and increase() can only see growth from a previous sample, so every country's FIRST connection was invisible. Measured on a live proxy, increase saw 2 countries where max_over_time saw 7. Trade-off: if the container restarts mid-window this shows the larger run rather than the sum.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "targets": [
        {
          "expr": "100 * sum(max_over_time(tor_snowflake_proxy_connections_total[$__range])) / (sum(max_over_time(tor_snowflake_proxy_connections_total[$__range])) + sum(max_over_time(tor_snowflake_proxy_connection_timeouts_total[$__range])))",
          "refId": "A",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
